{
  "title": "PostDevice",
  "description": "Cadastra um dispositivo de um cliente em registered_device (a R1 consulta a API externa de dispositivo).",
  "type": "object",
  "properties": {
    "document_number": {
      "type": "string",
      "minLength": 11,
      "maxLength": 18,
      "pattern": "^[0-9A-Za-z./-]+$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    }
  },
  "required": ["document_number", "device_id"],
  "additionalProperties": false
}
