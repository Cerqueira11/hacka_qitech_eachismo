{
  "title": "PostDevice",
  "description": "Cadastra um dispositivo de um cliente (regra R1).",
  "type": "object",
  "properties": {
    "document_number": {
      "type": "string",
      "minLength": 11,
      "maxLength": 18,
      "pattern": "^[0-9A-Za-z./-]+$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    }
  },
  "required": ["document_number", "device_id"],
  "additionalProperties": false
}
