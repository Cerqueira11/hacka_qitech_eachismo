{
  "title": "PostPixTransaction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "amount": {
      "description": "Valor em centavos.",
      "type": "integer",
      "minimum": 1
    },
    "transaction_date": {
      "description": "ISO-8601 com fuso horário, ex.: 2026-10-17T22:15:00-03:00.",
      "type": "string",
      "minLength": 1
    },
    "source_account": {
      "type": "object",
      "properties": {
        "participant": {
          "description": "Opcional: a origem é sempre desta instituição (INSTITUTION_ISPB).",
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[0-9]{1,4}$"
        },
        "account_number": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "opening_date": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "minLength": 11,
              "maxLength": 18,
              "pattern": "^[0-9A-Za-z./-]+$"
            }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "participant": {
          "description": "ISPB da instituição de destino.",
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[0-9]{1,4}$"
        },
        "account_number": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "opening_date": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "minLength": 11,
              "maxLength": 18,
              "pattern": "^[0-9A-Za-z./-]+$"
            }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["participant", "branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "ip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45
        },
        "geolocation": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": ["latitude", "longitude"],
          "additionalProperties": false
        }
      },
      "required": ["device_id", "channel", "ip"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account",
    "source"
  ],
  "additionalProperties": false
}
