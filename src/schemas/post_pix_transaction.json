      "type": "integer",
      "minimum": 1
    },
    "source_account_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_document_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "destination_account_branch": {
      "type": "integer",
      "minimum": 1
    },
    "destination_account_number": {
      "type": "integer",
      "minimum": 1
