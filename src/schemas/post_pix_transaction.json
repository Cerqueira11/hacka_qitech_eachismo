    "destination_document_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "source_device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "source_device_channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "source_ip": {
      "type": "string",
      "minLength": 1
