diff --git a/database/migrations/001_v2_c2_c4_s2.sql b/database/migrations/001_v2_c2_c4_s2.sql
new file mode 100644
index 0000000..2a75e6e
--- /dev/null
+++ b/database/migrations/001_v2_c2_c4_s2.sql
@@ -0,0 +1,35 @@
+-- v1 -> v2 (decisões C2, C4 e S2). Só para bancos que já existiam:
+-- o database/database.sql já nasce com estas colunas.
+--
+--   psql "$DATABASE_URL" -f database/migrations/001_v2_c2_c4_s2.sql
+
+BEGIN;
+
+-- C2: true quando a conta já foi origem (conta nossa).
+ALTER TABLE account_node
+    ADD COLUMN IF NOT EXISTS document_verified BOOLEAN NOT NULL DEFAULT false;
+
+-- Toda conta que já apareceu como origem passa a verificada.
+UPDATE account_node a
+   SET document_verified = true
+ WHERE EXISTS (SELECT 1 FROM transaction_history t WHERE t.source_account_id = a.id_account);
+
+-- C4: hash do payload normalizado (NULL nas linhas antigas).
+ALTER TABLE transaction_history
+    ADD COLUMN IF NOT EXISTS payload_sha256 CHAR(64);
+
+-- S2: resposta da API de dispositivo no momento do Pix.
+ALTER TABLE transaction_history
+    ADD COLUMN IF NOT EXISTS device_registered BOOLEAN;
+
+-- Pix antigos: o que a tabela registered_device dizia (melhor aproximação).
+UPDATE transaction_history t
+   SET device_registered = EXISTS (
+         SELECT 1
+           FROM registered_device d
+           JOIN account_node a ON a.id_account = t.source_account_id
+          WHERE d.document_number = a.document_number
+            AND d.device_id = t.source_device_id)
+ WHERE t.device_registered IS NULL;
+
+COMMIT;
